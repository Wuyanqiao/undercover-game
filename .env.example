# 谁是卧底 - 环境变量配置
# 复制此文件为 .env 并填写实际值

# 域名配置
DOMAIN=who-is-spy.online
EMAIL=jiujiangzhie@qq.com
LETSENCRYPT_STAGING=0

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Redis 配置
REDIS_URL=redis://redis:6379

# 后端配置
NODE_ENV=production
PORT=3000
APP_VERSION=dev

# 游戏配置
MAX_ROOMS=3
MAX_AI_CONCURRENT=2
ROOM_TIMEOUT_MINUTES=10
SPEECH_TIMEOUT_SECONDS=90
VOTE_TIMEOUT_SECONDS=90
TIEBREAK_TIMEOUT_SECONDS=90

# JWT 密钥（用于生成 resume token）
JWT_SECRET=change-this-to-a-random-long-secret
